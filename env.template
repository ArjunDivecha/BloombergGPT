# Bloomberg Data Broker Configuration
# Copy this file to .env and fill in your values

# API Key for Bloomberg Data Broker authentication
# This is the key ChatGPT (or any client) uses when calling /blp/* endpoints
API_KEY=Caeser00**

# Cloudflare Tunnel (optional notes)
# The Cloudflare tunnel is configured via cloudflared-broker.yml.
# If you automate cloudflared as a service you can store additional
# environment variables here (e.g., CLOUDFLARED_CONFIG). For now the
# batch file start_cloudflared.bat reads the config path directly, so no
# additional settings are required.

# Bloomberg API Settings
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194

# Broker Settings
BROKER_HOST=0.0.0.0
BROKER_PORT=8000
RATE_LIMIT=60/minute
